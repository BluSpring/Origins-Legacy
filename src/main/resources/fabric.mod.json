{
  "schemaVersion": 1,
  "id": "origins-legacy",
  "version": "${version}",
  "provides":[
    "origins"
  ],
  "name": "Origins: Legacy",
  "description": "This mod adds several origins with passive abilities to the game, which you can choose from at the beginning of the game.\nUnofficial forward port beginning from Minecraft 1.20.1, which includes backwards-compatible support for Origins built for MC 1.20.1 and prior.",
  "authors": [
    "Apace",
    "BluSpring"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/origins",
    "sources": "https://git.devos.one/BluSpring/origins-legacy",
    "issues": "https://git.devos.one/BluSpring/origins-legacy/issues"
  },

  "license": "MIT",
  "icon": "assets/origins/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.apace100.origins.Origins"
    ],
    "client": [
      "io.github.apace100.origins.OriginsClient"
    ],
    "modmenu": [
      "io.github.apace100.origins.integration.ModMenuIntegration"
    ],
    "cardinal-components-entity": [
      "io.github.apace100.origins.registry.ModComponents"
    ],
    "calio:ordered-resource-listener": [
      "io.github.apace100.origins.Origins"
    ]
  },
  "mixins": [
    "origins.mixins.json"
  ],
  "custom": {
    "cardinal-components": [
      "origins:origin"
    ]
  },

  "depends": {
    "java": ">=21",
    "fabricloader": ">=0.16.7",
    "fabric-api": ">=0.116.1",
    "minecraft": ">=1.21.1",
    "apoli-legacy": ">=2.9.0",
    "calio-legacy": ">=1.11.0",
    "playerabilitylib": ">=1.3.0",
    "cardinal-components-base": ">=3.0.0",
    "cardinal-components-entity": ">=3.0.0",
    "cloth-config2": ">=5.0.0"
  },
  "breaks": {
    "optifabric": "<=1.11.18",
    "identity": "<1.14.2-beta"
  }
}
